# ==============================================================================
# VENDETTA - VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# Copia este archivo como '.env' en la raíz y define tus valores antes de iniciar.
# ==============================================================================

# ------------------------------------------------------------------------------
# BASE DE DATOS (Prisma ORM)
# ------------------------------------------------------------------------------
# Cadena de conexión principal (PostgreSQL / MySQL)
# Ejemplo PostgreSQL estándar:
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/vendetta_db?schema=public"

# Ejemplo MySQL (en caso de alternar datasource en schema.prisma):
# DATABASE_URL="mysql://usuario:contraseña@localhost:3306/vendetta_db"

# URL directa a la base de datos (requerida al utilizar Prisma Accelerate o PgBouncer):
DIRECT_DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/vendetta_db?sslmode=require"

# ------------------------------------------------------------------------------
# AUTENTICACIÓN Y SEGURIDAD DE SESIÓN
# ------------------------------------------------------------------------------
# Clave secreta para NextAuth / firma de tokens JWT (generar con `openssl rand -hex 32`)
NEXTAUTH_SECRET="tu_secreto_super_seguro_para_nextauth_de_minimo_32_caracteres"
NEXTAUTH_URL="http://localhost:3000"

# Secreto de sesión utilizado por las utilidades jose en src/lib/session.ts
SESSION_SECRET="tu_secreto_para_sesion_jose_de_32_bytes_hex"

# ------------------------------------------------------------------------------
# TAREAS PROGRAMADAS Y CRONS (Cálculo de ticks y producción)
# ------------------------------------------------------------------------------
CRON_SECRET="clave_secreta_para_proteger_endpoints_de_cron"

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DEL ENTORNO
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
